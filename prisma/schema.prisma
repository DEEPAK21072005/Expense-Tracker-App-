generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  name              String
  passwordHash      String
  baseCurrency      String              @default("INR")
  timezone          String              @default("Asia/Kolkata")
  theme             String              @default("system")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sessions          Session[]
  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  budgets           Budget[]
  recurringPayments RecurringPayment[]
  splitGroups       ExpenseSplitGroup[]
  reports           Report[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Account {
  id                String             @id @default(cuid())
  userId            String
  name              String
  type              String             @default("BANK")
  currency          String             @default("INR")
  balanceMinor      Int                @default(0)
  isArchived        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]      @relation("SourceAccount")
  toTransactions    Transaction[]      @relation("DestinationAccount")
  recurringPayments RecurringPayment[]

  @@unique([userId, name])
  @@index([userId, isArchived])
}

model Category {
  id                String             @id @default(cuid())
  userId            String
  name              String
  type              String             @default("EXPENSE")
  icon              String             @default("tag")
  color             String             @default("#64748B")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  budgets           Budget[]
  recurringPayments RecurringPayment[]

  @@unique([userId, name, type])
  @@index([userId, type])
}

model Transaction {
  id                 String            @id @default(cuid())
  userId             String
  accountId          String
  toAccountId        String?
  categoryId         String?
  amountMinor        Int
  currency           String            @default("INR")
  type               String            @default("EXPENSE")
  date               DateTime          @default(now())
  payee              String?
  notes              String?
  tags               String?
  isRecurring        Boolean           @default(false)
  recurringPaymentId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            Account           @relation("SourceAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccount          Account?          @relation("DestinationAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  category           Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringPayment   RecurringPayment? @relation(fields: [recurringPaymentId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, accountId])
  @@index([userId, categoryId])
}

model Budget {
  id             String    @id @default(cuid())
  userId         String
  categoryId     String?
  amountMinor    Int
  period         String    @default("MONTHLY")
  month          Int?
  year           Int?
  alertThreshold Float     @default(0.85)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
}

model RecurringPayment {
  id                String        @id @default(cuid())
  userId            String
  accountId         String
  categoryId        String?
  description       String
  amountMinor       Int
  currency          String        @default("INR")
  frequency         String        @default("MONTHLY")
  nextDate          DateTime
  lastProcessedDate DateTime?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category          Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions      Transaction[]

  @@index([userId, nextDate])
}

model ExpenseSplitGroup {
  id          String         @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  members     SplitMember[]
  expenses    SplitExpense[]

  @@unique([userId, name])
  @@index([userId])
}

model SplitMember {
  id           String            @id @default(cuid())
  groupId      String
  name         String
  email        String?
  createdAt    DateTime          @default(now())
  group        ExpenseSplitGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidExpenses SplitExpense[]    @relation("PaidBy")
  shares       SplitShare[]

  @@unique([groupId, name])
  @@index([groupId])
}

model SplitExpense {
  id          String            @id @default(cuid())
  groupId     String
  paidById    String
  description String
  amountMinor Int
  currency    String            @default("INR")
  date        DateTime          @default(now())
  splitType   String            @default("EQUAL")
  createdAt   DateTime          @default(now())
  group       ExpenseSplitGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy      SplitMember       @relation("PaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  shares      SplitShare[]

  @@index([groupId, date])
}

model SplitShare {
  id             String       @id @default(cuid())
  splitExpenseId String
  memberId       String
  shareMinor     Int
  isSettled      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  splitExpense   SplitExpense @relation(fields: [splitExpenseId], references: [id], onDelete: Cascade)
  member         SplitMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([splitExpenseId, memberId])
  @@index([memberId])
}

model Report {
  id                String   @id @default(cuid())
  userId            String
  month             Int
  year              Int
  title             String
  totalIncomeMinor  Int      @default(0)
  totalExpenseMinor Int      @default(0)
  netSavingsMinor   Int      @default(0)
  generatedAt       DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, year, month])
}
