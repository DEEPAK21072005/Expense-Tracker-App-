# SQLite for local development (default). Use a hosted DB (Neon, PlanetScale) for production.
DATABASE_URL="file:./dev.db"

# REQUIRED: 48+ random bytes for HMAC-signed cookie sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# On Vercel: add this in Project Settings → Environment Variables
SESSION_SECRET="replace-with-a-unique-random-secret"
