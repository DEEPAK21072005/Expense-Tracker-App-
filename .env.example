# Required for all environments. Use a durable hosted PostgreSQL database in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/expense_tracker?sslmode=require"
# Direct non-pooled connection for migrations. May equal DATABASE_URL if your provider does not pool.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/expense_tracker?sslmode=require"
# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-unique-random-secret"
